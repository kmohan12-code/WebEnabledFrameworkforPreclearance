<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="55.0"/> 
    <vType id="truck" vClass="truck" accel="1.2" decel="3.5" sigma="0.6" length="10.0" minGap="3.0" maxSpeed="40.0" color="yellow"/>
    <vType id="bike" vClass="motorcycle" accel="3.5" decel="6.0" sigma="0.5" length="2.0" minGap="1.0" maxSpeed="80.0" color="red"/>
    <vType id="bus" vClass="bus" accel="1.0" decel="3.0" sigma="0.6" length="12.0" minGap="3.0" maxSpeed="40.0" color="blue"/>

    <vType id="ambulance" vClass="emergency" accel="3.0" decel="6.0" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="70.0" color="red" guiShape="emergency"/>

    <vTypeDistribution id="standard_mix">
        <vType vClass="passenger" id="car_dist" length="5.0" probability="0.70"/>
        <vType vClass="truck" id="truck_dist" length="10.0" probability="0.15"/>
        <vType vClass="motorcycle" id="bike_dist" length="2.0" probability="0.10"/>
        <vType vClass="bus" id="bus_dist" length="12.0" probability="0.05"/>
    </vTypeDistribution>

</routes>